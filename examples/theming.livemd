# kino_ex_ratatui — Theming and display options

```elixir
# When iterating on kino_ex_ratatui itself, swap the line below for
# `{:kino_ex_ratatui, path: Path.expand("..", __DIR__)}`.
Mix.install([
  {:kino_ex_ratatui, path: Path.expand("..", __DIR__)}
])
```

## What this notebook shows

Every per-instance display option `Kino.ExRatatui.new/2` and `Kino.ExRatatui.frame/2` accept, side by side: full xterm.js [`ITheme`](https://xtermjs.org/docs/api/terminal/interfaces/itheme/) maps, custom fonts and sizes, container heights, cursor styling, and the message painted into the iframe when the runtime exits.

The same App is reused everywhere — only the display opts change — so any visible difference between cells is purely the configuration talking.

## A small showcase App

This App ignores its mount opts other than a `:label` it prints in the header, and renders a header / palette / gauge / footer layout. It's intentionally chatty about colors so theme changes are obvious at a glance.

```elixir
defmodule ThemeShowcase do
  use ExRatatui.App

  alias ExRatatui.Event.Key
  alias ExRatatui.Layout
  alias ExRatatui.Layout.Rect
  alias ExRatatui.Style
  alias ExRatatui.Text.{Line, Span}
  alias ExRatatui.Widgets.{Block, Gauge, Paragraph}

  @impl true
  def mount(opts), do: {:ok, %{label: opts[:label] || "demo", n: 50}}

  @impl true
  def render(state, frame) do
    area = %Rect{x: 0, y: 0, width: frame.width, height: frame.height}

    [header_area, palette_area, gauge_area, footer_area] =
      Layout.split(
        area,
        :vertical,
        [{:length, 3}, {:length, 3}, {:length, 3}, {:min, 0}]
      )

    [
      {header(state.label), header_area},
      {palette(), palette_area},
      {gauge(state.n), gauge_area},
      {footer(), footer_area}
    ]
  end

  @impl true
  def handle_event(%Key{code: "+"}, s), do: {:noreply, %{s | n: min(100, s.n + 5)}}
  def handle_event(%Key{code: "-"}, s), do: {:noreply, %{s | n: max(0, s.n - 5)}}
  def handle_event(%Key{code: "q"}, s), do: {:stop, s}
  def handle_event(_, s), do: {:noreply, s}

  defp header(label) do
    %Paragraph{
      text: " ✨ #{label}",
      style: %Style{fg: :cyan, modifiers: [:bold]},
      block: %Block{
        borders: [:all],
        border_type: :rounded,
        border_style: %Style{fg: :cyan}
      }
    }
  end

  defp palette do
    %Paragraph{
      text: %Line{
        spans: [
          %Span{content: " black ", style: %Style{fg: :black, bg: :white}},
          %Span{content: " red ", style: %Style{fg: :red}},
          %Span{content: " green ", style: %Style{fg: :green}},
          %Span{content: " yellow ", style: %Style{fg: :yellow}},
          %Span{content: " blue ", style: %Style{fg: :blue}},
          %Span{content: " magenta ", style: %Style{fg: :magenta}},
          %Span{content: " cyan ", style: %Style{fg: :cyan}},
          %Span{content: " white ", style: %Style{fg: :white, bg: :black}}
        ]
      },
      block: %Block{
        borders: [:all],
        border_style: %Style{fg: :dark_gray},
        title: " palette "
      }
    }
  end

  defp gauge(value) do
    %Gauge{
      ratio: value / 100,
      label: "#{value}%",
      style: %Style{fg: :magenta, bg: :black},
      block: %Block{
        borders: [:all],
        border_style: %Style{fg: :magenta},
        title: " progress "
      }
    }
  end

  defp footer do
    %Paragraph{
      text: "  + / -  adjust   ·   q  quit",
      style: %Style{fg: :dark_gray, modifiers: [:italic]}
    }
  end
end
```

## 1 · Default look

No opts — the widget paints with the `kino_ex_ratatui` defaults (catppuccin-style dark, `ui-monospace` 13px, 400px tall, blinking cursor).

```elixir
Kino.ExRatatui.new(ThemeShowcase, label: "default")
```

## 2 · Custom theme — One Dark

`:theme` accepts the full xterm.js `ITheme` object — the 16-color ANSI palette plus selection / cursor accents. Atoms map to camelCase JSON keys (`:cursorAccent`, `:selectionBackground`, …) without translation.

```elixir
one_dark = %{
  background: "#282c34",
  foreground: "#abb2bf",
  cursor: "#528bff",
  cursorAccent: "#282c34",
  selectionBackground: "#3e4451",
  black: "#282c34",
  red: "#e06c75",
  green: "#98c379",
  yellow: "#e5c07b",
  blue: "#61afef",
  magenta: "#c678dd",
  cyan: "#56b6c2",
  white: "#abb2bf",
  brightBlack: "#5c6370",
  brightRed: "#e06c75",
  brightGreen: "#98c379",
  brightYellow: "#e5c07b",
  brightBlue: "#61afef",
  brightMagenta: "#c678dd",
  brightCyan: "#56b6c2",
  brightWhite: "#ffffff"
}

Kino.ExRatatui.new(ThemeShowcase, label: "one dark", theme: one_dark)
```

## 3 · Light theme — Solarized Light

A light theme sits awkwardly against Livebook's default dark cell background. The next section shows the easier way: the `:livebook` atom shorthand makes the terminal follow your OS-level light/dark preference automatically.

```elixir
solarized_light = %{
  background: "#fdf6e3",
  foreground: "#657b83",
  cursor: "#586e75",
  cursorAccent: "#fdf6e3",
  selectionBackground: "#eee8d5",
  black: "#073642",
  red: "#dc322f",
  green: "#859900",
  yellow: "#b58900",
  blue: "#268bd2",
  magenta: "#d33682",
  cyan: "#2aa198",
  white: "#eee8d5",
  brightBlack: "#002b36",
  brightRed: "#cb4b16",
  brightGreen: "#586e75",
  brightYellow: "#657b83",
  brightBlue: "#839496",
  brightMagenta: "#6c71c4",
  brightCyan: "#93a1a1",
  brightWhite: "#fdf6e3"
}

Kino.ExRatatui.new(ThemeShowcase, label: "solarized light", theme: solarized_light)
```

## 4 · Atom theme shorthands — `:dark`, `:light`, `:livebook`

`:theme` accepts a full xterm.js `ITheme` map (the lowest-level form) or one of three atoms: `:dark` (the bundled Catppuccin Mocha-flavored palette), `:light` (Catppuccin Latte), or `:livebook` (picks `:dark` or `:light` based on the user's OS-level `prefers-color-scheme` and re-applies on the fly when that preference changes).

```elixir
Kino.ExRatatui.new(ThemeShowcase, label: ":livebook (auto)", theme: :dark)
```

Toggle your OS into light or dark mode with the cell above running — the terminal swaps to match without a re-eval.

## 5 · Global defaults via `configure/1`

`Kino.ExRatatui.configure/1` writes display defaults to the `:kino_ex_ratatui` Application environment so every subsequent `new/2` and `frame/2` call picks them up. Per-instance opts still win key-by-key.

```elixir
Kino.ExRatatui.configure(
  theme: :livebook,
  font_family: "JetBrains Mono, ui-monospace, monospace",
  font_size: 14
)

# This call uses the configured theme, font_family, and font_size,
# plus the module default for height/cursor_blink/scrollback.
Kino.ExRatatui.new(ThemeShowcase, label: "configured")
```

Per-instance overrides still apply — only the keys you set get overridden, the rest fall through to the configured value:

```elixir
# theme: overridden per-cell. font_family + font_size: still from configure/1.
Kino.ExRatatui.new(ThemeShowcase,
  label: "configured + override",
  theme: %{background: "#0d1117", foreground: "#c9d1d9"}
)
```

Reset the global config when you're done experimenting:

```elixir
for key <- [:theme, :font_family, :font_size, :height, :cursor_blink, :scrollback, :stopped_message] do
  Application.delete_env(:kino_ex_ratatui, key)
end
```

## 6 · Custom font and size

`:font_family` accepts any CSS `font-family` value, `:font_size` is in pixels, and `:height` is any CSS length (`"600px"`, `"60vh"`, `"calc(100vh - 200px)"`, …) applied to the xterm.js host element.

```elixir
Kino.ExRatatui.new(ThemeShowcase,
  label: "fira code 16px",
  font_family: "Fira Code, JetBrains Mono, ui-monospace, monospace",
  font_size: 16,
  height: "550px"
)
```

Heads up: `:font_family` is a CSS string, so the visible font is whichever entry your browser finds installed first. If neither [Fira Code](https://github.com/tonsky/FiraCode) nor JetBrains Mono is on your system the stack falls all the way to the generic `monospace` — the same place the default stack lands — and you'll only notice the size change.

To convince yourself the option is actually applied, swap the family for something universally installed and visually unmistakable. The cell below uses `serif`, which has actual letterform serifs (and is therefore obviously not monospace):

```elixir
Kino.ExRatatui.new(ThemeShowcase,
  label: "serif (proves :font_family is applied)",
  font_family: "Georgia, serif"
)
```

## 7 · Cursor and stopped-message overrides

`:cursor_blink` is a boolean (xterm.js's option of the same name); `:stopped_message` is the dim italic text painted into the iframe after the App returns `{:stop, _}` or `mount/1` fails.

Press `q` in the cell below to see the custom stopped message.

```elixir
Kino.ExRatatui.new(ThemeShowcase,
  label: "no blink, custom stop",
  cursor_blink: false,
  stopped_message: "👋  thanks for trying it out — re-run the cell to come back"
)
```

## 8 · Static gallery — three themes side by side

`Kino.ExRatatui.frame/2` accepts the static-friendly subset of display opts: `:theme`, `:font_family`, `:font_size`. The same widget tree is rendered three times below; only `:theme` differs.

```elixir
alias ExRatatui.Layout
alias ExRatatui.Layout.Rect
alias ExRatatui.Style
alias ExRatatui.Text.{Line, Span}
alias ExRatatui.Widgets.{Block, Paragraph}

dracula = %{
  background: "#282a36",
  foreground: "#f8f8f2",
  cursor: "#f8f8f2",
  cursorAccent: "#282a36",
  selectionBackground: "#44475a",
  black: "#21222c",
  red: "#ff5555",
  green: "#50fa7b",
  yellow: "#f1fa8c",
  blue: "#bd93f9",
  magenta: "#ff79c6",
  cyan: "#8be9d4",
  white: "#f8f8f2",
  brightBlack: "#6272a4",
  brightRed: "#ff6e6e",
  brightGreen: "#69ff94",
  brightYellow: "#ffffa5",
  brightBlue: "#d6acff",
  brightMagenta: "#ff92df",
  brightCyan: "#a4ffff",
  brightWhite: "#ffffff"
}

frame_for = fn label, theme ->
  rect = %Rect{x: 0, y: 0, width: 36, height: 7}
  [top, bottom] = Layout.split(rect, :vertical, [{:length, 3}, {:min, 0}])

  Kino.ExRatatui.frame(
    [
      {%Paragraph{
         text: " #{label}",
         style: %Style{fg: :cyan, modifiers: [:bold]},
         block: %Block{borders: [:all], border_type: :rounded}
       }, top},
      {%Paragraph{
         text: %Line{
           spans: [
             %Span{content: " ■ ", style: %Style{fg: :red}},
             %Span{content: " ■ ", style: %Style{fg: :green}},
             %Span{content: " ■ ", style: %Style{fg: :yellow}},
             %Span{content: " ■ ", style: %Style{fg: :blue}},
             %Span{content: " ■ ", style: %Style{fg: :magenta}},
             %Span{content: " ■ ", style: %Style{fg: :cyan}},
             %Span{content: " ■", style: %Style{fg: :white}}
           ]
         },
         block: %Block{borders: [:all], border_style: %Style{fg: :dark_gray}}
       }, bottom}
    ],
    cols: 36,
    rows: 7,
    theme: theme
  )
end

Kino.Layout.grid(
  [
    frame_for.("default", %{
      background: "#1e1e2e",
      foreground: "#cdd6f4",
      cursor: "#f5e0dc"
    }),
    frame_for.("dracula", dracula),
    frame_for.("solarized light", solarized_light)
  ],
  columns: 3
)
```

## 9 · Validation

Bad shapes raise `ArgumentError` at the call site — there's no silent fallback to the default. The message names the offending option so typos are caught immediately rather than producing a working-but-wrong widget.

```elixir
try do
  Kino.ExRatatui.new(ThemeShowcase, theme: :dark)
rescue
  e in ArgumentError -> e.message
end
```

```elixir
try do
  # Live-only opts are rejected on `frame/2`.
  Kino.ExRatatui.frame([], cols: 10, rows: 1, height: "200px")
rescue
  e in ArgumentError -> e.message
end
```

