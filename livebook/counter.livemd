# kino_ex_ratatui — Counter

```elixir
# When kino_ex_ratatui is published to hex, swap the path: form
# below for `{:kino_ex_ratatui, "~> 0.1"}`.
Mix.install([
  {:kino_ex_ratatui, path: Path.expand("..", __DIR__)}
])
```

## What this notebook shows

A small `ExRatatui.App` running inside Livebook via xterm.js.

The `Counter` module below is a standard `ExRatatui.App` — the same module would run unchanged over the local tty (`ExRatatui.run/1`), over SSH (`ExRatatui.SSH.Daemon`), or attached over Erlang distribution. `Kino.ExRatatui` is just one more transport.

Cell re-evaluation tears the runtime down and starts a new one — state resets on every run.

## The Counter App

A small showcase of layout splits, rich-text spans, colored borders, and four widgets — `Paragraph`, `Block`, `Sparkline`, and `Gauge`.

```elixir
defmodule Counter do
  use ExRatatui.App

  alias ExRatatui.Event.Key
  alias ExRatatui.Layout
  alias ExRatatui.Layout.Rect
  alias ExRatatui.Style
  alias ExRatatui.Text.{Line, Span}
  alias ExRatatui.Widgets.{Block, Gauge, Paragraph, Sparkline}

  @max 50
  @history 60

  @impl true
  def mount(_opts), do: {:ok, %{n: 0, history: [0]}}

  @impl true
  def render(state, frame) do
    area = %Rect{x: 0, y: 0, width: frame.width, height: frame.height}

    [header, body, footer] =
      Layout.split(area, :vertical, [{:length, 3}, {:min, 0}, {:length, 5}])

    [count_area, history_area] =
      Layout.split(body, :horizontal, [{:percentage, 50}, {:percentage, 50}])

    [gauge_area, help_area] =
      Layout.split(footer, :vertical, [{:length, 3}, {:length, 2}])

    [
      {header_widget(), header},
      {count_widget(state), count_area},
      {history_widget(state), history_area},
      {gauge_widget(state), gauge_area},
      {help_widget(), help_area}
    ]
  end

  ## Widgets

  defp header_widget do
    %Paragraph{
      alignment: :center,
      text: %Line{
        spans: [
          %Span{content: "kino_ex_ratatui ", style: %Style{fg: :cyan, modifiers: [:bold]}},
          %Span{content: "·", style: %Style{fg: :gray}},
          %Span{
            content: " a counter, but make it ratatui ",
            style: %Style{fg: :white, modifiers: [:italic]}
          }
        ]
      },
      block: %Block{borders: [:all], border_style: %Style{fg: :cyan}}
    }
  end

  defp count_widget(state) do
    color = count_color(state.n)

    %Paragraph{
      alignment: :center,
      text: [
        %Line{spans: []},
        %Line{spans: []},
        %Line{
          spans: [
            %Span{
              content: "#{state.n}",
              style: %Style{fg: color, modifiers: [:bold]}
            }
          ]
        },
        %Line{spans: []},
        %Line{
          spans: [
            %Span{
              content: trend_label(state),
              style: %Style{fg: :gray, modifiers: [:italic]}
            }
          ]
        }
      ],
      block: %Block{
        borders: [:all],
        border_style: %Style{fg: color},
        title: %Span{content: " Count ", style: %Style{fg: color, modifiers: [:bold]}}
      }
    }
  end

  defp history_widget(state) do
    %Sparkline{
      data: Enum.reverse(state.history),
      max: @max,
      style: %Style{fg: :magenta},
      block: %Block{
        borders: [:all],
        border_style: %Style{fg: :magenta},
        title: %Span{content: " History ", style: %Style{fg: :magenta, modifiers: [:bold]}}
      }
    }
  end

  defp gauge_widget(state) do
    pct = min(abs(state.n) / @max, 1.0)

    %Gauge{
      ratio: pct,
      label: " #{trunc(pct * 100)}% of #{@max} ",
      style: %Style{fg: count_color(state.n)},
      block: %Block{
        borders: [:all],
        border_style: %Style{fg: :gray},
        title: %Span{content: " Progress ", style: %Style{fg: :gray, modifiers: [:bold]}}
      }
    }
  end

  defp help_widget do
    %Paragraph{
      alignment: :center,
      text: %Line{
        spans: [
          %Span{content: " ", style: %Style{}},
          key("+"), label(" increment   "),
          key("-"), label(" decrement   "),
          key("r"), label(" reset       "),
          key("q"), label(" quit ")
        ]
      }
    }
  end

  defp key(k), do: %Span{content: k, style: %Style{fg: :black, bg: :white, modifiers: [:bold]}}
  defp label(t), do: %Span{content: t, style: %Style{fg: :gray}}

  ## Behaviour

  defp count_color(n) when n > 0, do: :green
  defp count_color(n) when n < 0, do: :red
  defp count_color(_), do: :white

  defp trend_label(%{history: [_]}), do: "press + or - to start"
  defp trend_label(%{history: [a, b | _]}) when a > b, do: "trending up"
  defp trend_label(%{history: [a, b | _]}) when a < b, do: "trending down"
  defp trend_label(_), do: "steady"

  @impl true
  def handle_event(%Key{code: "+"}, state), do: {:noreply, bump(state, +1)}
  def handle_event(%Key{code: "-"}, state), do: {:noreply, bump(state, -1)}
  def handle_event(%Key{code: "r"}, _state), do: {:noreply, %{n: 0, history: [0]}}
  def handle_event(%Key{code: "q"}, state), do: {:stop, state}
  def handle_event(_event, state), do: {:noreply, state}

  defp bump(%{n: n, history: hist}, delta) do
    new_n = n + delta
    sample = min(abs(new_n), @max)
    %{n: new_n, history: [sample | Enum.take(hist, @history - 1)]}
  end
end
```

<!-- livebook:{"output":true} -->

```
{:module, Counter, <<70, 79, 82, 49, 0, 0, 101, ...>>, {:bump, 2}}
```

## Run it

Click into the terminal below to focus it, then:

* `+` and `-` move the counter — the border + number + gauge all track the sign
* `r` resets to zero
* `q` quits (cell re-eval starts fresh)

The Sparkline tracks the last 60 magnitudes, the Gauge below shows progress toward `±50`, and the trend label updates every step.

```elixir
Kino.ExRatatui.new(Counter)
```

## Bonus: a static frame

`Kino.ExRatatui.frame/2` renders a one-shot `[{widget, rect}, ...]` list with no event loop and no runtime server — handy for documentation, side-by-side widget galleries via `Kino.Layout.grid/1`, or freezing a snapshot of what something looks like.

```elixir
alias ExRatatui.Layout
alias ExRatatui.Layout.Rect
alias ExRatatui.Style
alias ExRatatui.Text.{Line, Span}
alias ExRatatui.Widgets.{Bar, BarChart, Block, Paragraph}

frame_rect = %Rect{x: 0, y: 0, width: 70, height: 12}
[top, bottom] = Layout.split(frame_rect, :vertical, [{:length, 3}, {:min, 0}])

Kino.ExRatatui.frame(
  [
    {%Paragraph{
       alignment: :center,
       text: %Line{
         spans: [
           %Span{content: "ratatui ", style: %Style{fg: :magenta, modifiers: [:bold]}},
           %Span{content: "in your notebook ", style: %Style{fg: :white}},
           %Span{content: "·", style: %Style{fg: :gray}},
           %Span{
             content: " no event loop, no server",
             style: %Style{fg: :gray, modifiers: [:italic]}
           }
         ]
       },
       block: %Block{borders: [:all], border_style: %Style{fg: :magenta}}
     }, top},
    {%BarChart{
       data: [
         %Bar{label: "Mon", value: 12, style: %Style{fg: :cyan}},
         %Bar{label: "Tue", value: 18, style: %Style{fg: :green}},
         %Bar{label: "Wed", value: 9, style: %Style{fg: :yellow}},
         %Bar{label: "Thu", value: 22, style: %Style{fg: :magenta}},
         %Bar{label: "Fri", value: 31, style: %Style{fg: :red}}
       ],
       bar_width: 6,
       bar_gap: 2,
       block: %Block{
         borders: [:all],
         border_style: %Style{fg: :gray},
         title: %Span{
           content: " weekly stats ",
           style: %Style{fg: :white, modifiers: [:bold]}
         }
       }
     }, bottom}
  ],
  cols: 70,
  rows: 12
)
```

## Where to next

* The [Custom Transports guide](https://hexdocs.pm/ex_ratatui/custom_transports.html) walks through how `Kino.ExRatatui` plugs into ExRatatui's transport behaviour — useful if you want to write your own.
* [`ExRatatui.App` docs](https://hexdocs.pm/ex_ratatui/ExRatatui.App.html) cover the full callback contract this Counter implements.
* The [Building UIs guide](https://hexdocs.pm/ex_ratatui/building_uis.html) catalogs every widget and shows how to compose them with the layout engine.
